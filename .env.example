# Optional SSH private key path. Defaults to ~/.ssh/id_rsa.
# VYOPS_SSH_KEY=~/.ssh/id_rsa

# Optional SSH agent socket.
# SSH_AUTH_SOCK=

# Optional known-hosts file. Defaults to ~/.ssh/known_hosts.
# SSH_KNOWN_HOSTS=~/.ssh/known_hosts

# Optional trusted host CA public key.
# SSH_HOST_CA=

# Optional SSH connection timeout in milliseconds. Defaults to 30000.
# VYOPS_CONNECT_TIMEOUT=30000

# Optional SSH operation timeout in milliseconds. Defaults to 60000.
# VYOPS_OPERATION_TIMEOUT=60000

# Optional interactive operation timeout in milliseconds. Defaults to 60000.
# VYOPS_INTERACTIVE_TIMEOUT=60000

# Winston log level: error, warn, info, http, verbose, debug, or silly.
# LOG_LEVEL=info
