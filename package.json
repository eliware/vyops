{
  "name": "vyops",
  "version": "1.0.0",
  "description": "Deploy native VyOS configuration files over SSH.",
  "main": "vyops.mjs",
  "scripts": {
    "lint": "npx oxlint .",
    "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --coverage --detectOpenHandles --silent --runInBand",
    "deploy": "./vyops.mjs",
    "validate": "./preflight.mjs",
    "preflight": "./preflight.mjs",
    "test:gaps": "npm test 2>&1 | grep '|' | grep -vF '|     100 |      100 |     100 |     100 |'"
  },
  "keywords": [
    "vyos",
    "networking",
    "gitops",
    "ssh",
    "cli"
  ],
  "type": "module",
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "oxlint": "^1.76.0"
  },
  "bin": {
    "vyops": "./vyops.mjs",
    "vyops-preflight": "./preflight.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/eliware/vyops-js.git"
  },
  "homepage": "https://github.com/eliware/vyops-js#readme",
  "bugs": {
    "url": "https://github.com/eliware/vyops-js/issues"
  }
}
