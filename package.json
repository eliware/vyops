{
    "name": "@eliware/vyops",
    "version": "2.1.0",
    "description": "Preflight, release, and back up native VyOS configuration bundles over SSH.",
    "main": "vyops.mjs",
    "scripts": {
        "lint": "eliware-test --lint",
        "test": "eliware-test",
        "deploy": "node vyops.mjs",
        "pack": "npm pack --dry-run",
        "validate:package": "npm pack --dry-run --json | node scripts/validate-package.mjs",
        "audit": "node scripts/audit.mjs"
    },
    "keywords": [
        "vyos",
        "networking",
        "gitops",
        "ssh",
        "cli"
    ],
    "type": "module",
    "dependencies": {
        "@eliware/common": "^1.1.8",
        "@eliware/ssh-client": "^2.0.0"
    },
    "devDependencies": {
        "@eliware/test": "^2.0.0"
    },
    "bin": {
        "vyops": "./bin/vyops"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/vyops.git"
    },
    "homepage": "https://github.com/eliware/vyops#readme",
    "bugs": {
        "url": "https://github.com/eliware/vyops/issues"
    },
    "files": [
        "vyops.mjs",
        "bin/",
        "src/",
        "README.md",
        "LICENSE",
        "RELEASE_NOTES.md"
    ]
}