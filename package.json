{
    "name": "@eliware/vyops",
    "version": "1.0.13",
    "description": "Deploy native VyOS configuration files over SSH.",
    "main": "vyops.mjs",
    "scripts": {
        "lint": "npx oxlint .",
        "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles --silent --coverage",
        "deploy": "./vyops.mjs",
        "test:gaps": "node scripts/test-gaps.mjs",
        "pack": "npm pack --dry-run",
        "validate:package": "npm pack --dry-run --json | node scripts/validate-package.mjs",
        "audit": "node scripts/audit.mjs"
    },
    "keywords": [
        "vyos",
        "networking",
        "gitops",
        "ssh",
        "cli"
    ],
    "type": "module",
    "dependencies": {
        "@eliware/common": "^1.1.8",
        "ssh2": "^1.17.0"
    },
    "devDependencies": {
        "jest": "^30.4.2",
        "oxlint": "^1.79.0"
    },
    "bin": {
        "vyops": "./bin/vyops"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/vyops.git"
    },
    "homepage": "https://github.com/eliware/vyops#readme",
    "bugs": {
        "url": "https://github.com/eliware/vyops/issues"
    },
    "files": [
        "vyops.mjs",
        "bin/",
        "src/",
        "README.md",
        "LICENSE",
        "RELEASE_NOTES.md"
    ]
}